# Porta do servidor
PORT=3001
# URL pública (usada no redirect do Google). Em dev com Vite: http://localhost:5173
PUBLIC_URL=http://localhost:3001
# Segredo do JWT de sessão (obrigatório em produção)
JWT_SECRET=troque-por-um-segredo-grande
# Google OAuth: https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizado: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Arquivo SQLite
DATABASE_FILE=./truco.db
# E-mails (separados por vírgula) com acesso ao painel /admin
ADMIN_EMAILS=
